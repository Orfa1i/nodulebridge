ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # current Claude Sonnet model id, set by the team; written for claude-sonnet-5-5
TTS_PROVIDER=               # e.g. azure | google | elevenlabs
TTS_API_KEY=
TTS_VOICE_AR=               # an ar-SA neural voice
TTS_VOICE_EN=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DATA_BASE_URL=              # where prepared case files are served from

NEXT_PUBLIC_DATA_BASE_URL=  # optional; defaults to /cases (copied by pnpm sync:cases). Production: the DATA_BASE_URL host

# Google AI Studio (Gemini) key. Not used by the extractor yet: it calls the Anthropic API.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite   # used when ANTHROPIC_API_KEY is empty; override LLM_PROVIDER=anthropic|gemini
