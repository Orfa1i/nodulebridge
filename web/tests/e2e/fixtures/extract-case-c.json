      "source_start": 785,
      "source_end": 792,
      "line": 23,
      "page": 1
    },
    {
      "id": "s028",
      "text": "The trachea and main bronchi are patent.",
      "start": 793,
      "end": 833,
      "source_start": 793,
      "source_end": 833,
      "line": 24,
      "page": 1
    },
    {
