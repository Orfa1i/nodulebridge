      "source_start": 834,
      "source_end": 867,
      "line": 25,
      "page": 1
    },
    {
      "id": "s030",
      "text": "There is no mucus plugging.",
      "start": 868,
      "end": 895,
      "source_start": 868,
      "source_end": 895,
      "line": 26,
      "page": 1
    },
    {
      "id": "s031",
      "text": "Lungs and pleura",
      "start": 896,
      "end": 912,
      "source_start": 896,
      "source_end": 912,
      "line": 27,
      "page": 1
    },
    {
      "id": "s032",
      "text": "The lungs are well expanded.",
      "start": 913,
      "end": 941,
      "source_start": 913,
      "source_end": 941,
      "line": 28,
      "page": 1
    },
    {
      "id": "s033",
      "text": "There is no consolidation or pulmonary oedema.",
      "start": 942,
      "end": 988,
      "source_start": 942,
      "source_end": 988,
      "line": 29,
      "page": 1
    },
    {
      "id": "s034",
      "text": "There is no pneumothorax.",
      "start": 989,
      "end": 1014,
      "source_start": 989,
      "source_end": 1014,
      "line": 30,
      "page": 1
    },
    {
      "id": "s035",
      "text": "There is no pleural effusion.",
      "start": 1015,
      "end": 1044,
      "source_start": 1015,
      "source_end": 1044,
      "line": 31,
      "page": 1
    },
    {
