      "source_start": 428,
      "source_end": 436,
      "line": 11,
      "page": 1
    },
    {
      "id": "s016",
      "text": "Chest wall and bones",
      "start": 437,
      "end": 457,
      "source_start": 437,
      "source_end": 457,
      "line": 12,
      "page": 1
    },
    {
      "id": "s017",
      "text": "There is a healing fracture of the right seventh rib, with early callus.",
      "start": 458,
      "end": 530,
      "source_start": 458,
      "source_end": 530,
      "line": 13,
      "page": 1
    },
    {
      "id": "s018",
      "text": "The alignment is anatomical.",
      "start": 531,
      "end": 559,
      "source_start": 531,
      "source_end": 559,
      "line": 14,
      "page": 1
    },
    {
      "id": "s019",
      "text": "No other acute rib fracture is seen.",
      "start": 560,
      "end": 596,
      "source_start": 560,
      "source_end": 596,
      "line": 15,
      "page": 1
    },
    {
      "id": "s020",
      "text": "The sternum and the visualised thoracic spine are intact.",
      "start": 597,
      "end": 654,
      "source_start": 597,
      "source_end": 654,
      "line": 16,
      "page": 1
    },
    {
      "id": "s021",
      "text": "The soft tissues of the chest wall are unremarkable.",
      "start": 655,
      "end": 707,
      "source_start": 655,
      "source_end": 707,
      "line": 17,
      "page": 1
    },
    {
      "id": "s022",
      "text": "Heart and vessels",
      "start": 708,
      "end": 725,
      "source_start": 708,
      "source_end": 725,
      "line": 18,
      "page": 1
    },
    {
      "id": "s023",
      "text": "The heart is normal in size.",
      "start": 726,
      "end": 754,
      "source_start": 726,
      "source_end": 754,
      "line": 19,
      "page": 1
    },
    {
      "id": "s024",
      "text": "There is no pericardial effusion.",
      "start": 755,
      "end": 788,
      "source_start": 755,
      "source_end": 788,
      "line": 20,
      "page": 1
    },
    {
      "id": "s025",
      "text": "The thoracic aorta is normal in calibre.",
      "start": 789,
      "end": 829,
      "source_start": 789,
      "source_end": 829,
      "line": 21,
      "page": 1
    },
    {
      "id": "s026",
      "text": "Mediastinum and hila",
      "start": 830,
      "end": 850,
      "source_start": 830,
      "source_end": 850,
      "line": 22,
      "page": 1
    },
    {
      "id": "s027",
      "text": "There is no mediastinal or hilar lymphadenopathy.",
      "start": 851,
      "end": 900,
      "source_start": 851,
      "source_end": 900,
      "line": 23,
      "page": 1
    },
    {
      "id": "s028",
      "text": "The oesophagus is unremarkable.",
      "start": 901,
      "end": 932,
      "source_start": 901,
      "source_end": 932,
      "line": 24,
      "page": 1
    },
    {
      "id": "s029",
      "text": "Airways",
      "start": 933,
      "end": 940,
      "source_start": 933,
      "source_end": 940,
      "line": 25,
      "page": 1
    },
    {
      "id": "s030",
      "text": "The trachea and main bronchi are patent.",
      "start": 941,
      "end": 981,
      "source_start": 941,
      "source_end": 981,
      "line": 26,
      "page": 1
    },
    {
      "id": "s031",
      "text": "Lungs and pleura",
      "start": 982,
      "end": 998,
      "source_start": 982,
      "source_end": 998,
      "line": 27,
      "page": 1
    },
    {
      "id": "s032",
      "text": "The lungs are well expanded.",
      "start": 999,
      "end": 1027,
      "source_start": 999,
      "source_end": 1027,
      "line": 28,
      "page": 1
    },
    {
      "id": "s033",
      "text": "There is no consolidation or pulmonary oedema.",
      "start": 1028,
      "end": 1074,
      "source_start": 1028,
      "source_end": 1074,
      "line": 29,
      "page": 1
    },
    {
      "id": "s034",
      "text": "There is no pneumothorax.",
      "start": 1075,
      "end": 1100,
      "source_start": 1075,
      "source_end": 1100,
      "line": 30,
      "page": 1
    },
    {
      "id": "s035",
      "text": "There is no pleural effusion.",
      "start": 1101,
      "end": 1130,
      "source_start": 1101,
      "source_end": 1130,
      "line": 31,
      "page": 1
    },
    {
      "id": "s036",
      "text": "However, a 9 mm solid nodule is seen in the right upper lobe.",
      "start": 1131,
      "end": 1192,
      "source_start": 1131,
      "source_end": 1192,
      "line": 32,
      "page": 1
    },
    {
      "id": "s037",
      "text": "No other pulmonary nodule is identified.",
      "start": 1193,
      "end": 1233,
      "source_start": 1193,
      "source_end": 1233,
      "line": 33,
      "page": 1
    },
    {
      "id": "s038",
      "text": "Upper abdomen",
      "start": 1234,
      "end": 1247,
      "source_start": 1234,
      "source_end": 1247,
      "line": 34,
      "page": 1
    },
    {
      "id": "s039",
      "text": "The visualised upper abdomen is unremarkable.",
      "start": 1248,
      "end": 1293,
      "source_start": 1248,
      "source_end": 1293,
      "line": 35,
      "page": 1
    },
    {
      "id": "s040",
      "text": "Impression",
      "start": 1294,
      "end": 1304,
      "source_start": 1294,
      "source_end": 1304,
      "line": 36,
      "page": 2
    },
    {
