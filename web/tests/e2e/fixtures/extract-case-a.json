      "source_start": 308,
      "source_end": 317,
      "line": 8,
      "page": 1
    },
    {
      "id": "s013",
      "text": "Axial CT of the chest with intravenous contrast, 2.5 mm slices.",
      "start": 318,
      "end": 381,
      "source_start": 318,
      "source_end": 381,
      "line": 9,
      "page": 1
    },
    {
      "id": "s014",
