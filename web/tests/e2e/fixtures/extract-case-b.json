      "end": 863,
      "source_start": 856,
      "source_end": 863,
      "line": 25,
      "page": 1
    },
    {
      "id": "s030",
      "text": "The trachea and main bronchi are patent.",
      "start": 864,
      "end": 904,
      "source_start": 864,
      "source_end": 904,
      "line": 26,
      "page": 1
    },
    {
      "id": "s031",
      "text": "Lungs and pleura",
      "start": 905,
      "end": 921,
      "source_start": 905,
      "source_end": 921,
      "line": 27,
      "page": 1
    },
    {
      "id": "s032",
      "text": "The lungs are well expanded.",
      "start": 922,
      "end": 950,
      "source_start": 922,
      "source_end": 950,
      "line": 28,
      "page": 1
    },
    {
      "id": "s033",
      "text": "There is no consolidation or pulmonary oedema.",
      "start": 951,
      "end": 997,
      "source_start": 951,
      "source_end": 997,
      "line": 29,
      "page": 1
    },
    {
      "id": "s034",
      "text": "There is no pneumothorax.",
      "start": 998,
      "end": 1023,
      "source_start": 998,
      "source_end": 1023,
      "line": 30,
      "page": 1
    },
    {
      "id": "s035",
      "text": "There is no pleural effusion.",
      "start": 1024,
      "end": 1053,
      "source_start": 1024,
      "source_end": 1053,
      "line": 31,
      "page": 1
    },
    {
