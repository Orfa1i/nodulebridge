      "text": "Lungs and pleura",
      "start": 843,
      "end": 859,
      "source_start": 843,
      "source_end": 859,
      "line": 25,
      "page": 1
    },
    {
      "id": "s030",
      "text": "The lungs are well expanded.",
      "start": 860,
      "end": 888,
      "source_start": 860,
      "source_end": 888,
      "line": 26,
      "page": 1
    },
    {
      "id": "s031",
      "text": "There is no consolidation or pulmonary oedema.",
