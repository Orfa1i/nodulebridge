      "end": 935,
      "source_start": 889,
      "source_end": 935,
      "line": 27,
      "page": 1
    },
    {
      "id": "s032",
      "text": "There is no pneumothorax.",
      "start": 936,
      "end": 961,
      "source_start": 936,
      "source_end": 961,
      "line": 28,
      "page": 1
    },
    {
      "id": "s033",
      "text": "There is no pleural effusion.",
