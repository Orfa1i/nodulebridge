      "source_start": 409,
      "source_end": 417,
      "line": 11,
      "page": 1
    },
    {
      "id": "s016",
      "text": "Chest wall and bones",
      "start": 418,
      "end": 438,
      "source_start": 418,
      "source_end": 438,
      "line": 12,
      "page": 1
    },
    {
      "id": "s017",
      "text": "No acute rib fracture is seen.",
      "start": 439,
      "end": 469,
      "source_start": 439,
      "source_end": 469,
      "line": 13,
      "page": 1
    },
    {
      "id": "s018",
      "text": "The sternum and the visualised thoracic spine are intact.",
      "start": 470,
      "end": 527,
      "source_start": 470,
      "source_end": 527,
      "line": 14,
      "page": 1
    },
    {
      "id": "s019",
      "text": "The soft tissues of the chest wall are unremarkable.",
      "start": 528,
      "end": 580,
      "source_start": 528,
      "source_end": 580,
      "line": 15,
      "page": 1
    },
    {
      "id": "s020",
      "text": "Heart and vessels",
      "start": 581,
      "end": 598,
      "source_start": 581,
      "source_end": 598,
      "line": 16,
      "page": 1
    },
    {
      "id": "s021",
      "text": "The heart is normal in size.",
      "start": 599,
      "end": 627,
      "source_start": 599,
      "source_end": 627,
      "line": 17,
      "page": 1
    },
    {
      "id": "s022",
      "text": "There is no pericardial effusion.",
      "start": 628,
      "end": 661,
      "source_start": 628,
      "source_end": 661,
      "line": 18,
      "page": 1
    },
    {
      "id": "s023",
      "text": "The thoracic aorta is normal in calibre.",
      "start": 662,
      "end": 702,
      "source_start": 662,
      "source_end": 702,
      "line": 19,
      "page": 1
    },
    {
      "id": "s024",
      "text": "Mediastinum and hila",
      "start": 703,
      "end": 723,
      "source_start": 703,
      "source_end": 723,
      "line": 20,
      "page": 1
    },
    {
      "id": "s025",
      "text": "There is no mediastinal or hilar lymphadenopathy.",
      "start": 724,
      "end": 773,
      "source_start": 724,
      "source_end": 773,
      "line": 21,
      "page": 1
    },
    {
      "id": "s026",
      "text": "The oesophagus is unremarkable.",
      "start": 774,
      "end": 805,
      "source_start": 774,
      "source_end": 805,
      "line": 22,
      "page": 1
    },
    {
      "id": "s027",
      "text": "Airways",
      "start": 806,
      "end": 813,
      "source_start": 806,
      "source_end": 813,
      "line": 23,
      "page": 1
    },
    {
      "id": "s028",
      "text": "The trachea and main bronchi are patent.",
      "start": 814,
      "end": 854,
      "source_start": 814,
      "source_end": 854,
      "line": 24,
      "page": 1
    },
    {
      "id": "s029",
      "text": "Lungs and pleura",
      "start": 855,
      "end": 871,
      "source_start": 855,
      "source_end": 871,
      "line": 25,
      "page": 1
    },
    {
      "id": "s030",
      "text": "The lungs are well expanded.",
      "start": 872,
      "end": 900,
      "source_start": 872,
      "source_end": 900,
      "line": 26,
      "page": 1
    },
    {
      "id": "s031",
      "text": "There is no consolidation or pulmonary oedema.",
      "start": 901,
      "end": 947,
      "source_start": 901,
      "source_end": 947,
      "line": 27,
      "page": 1
    },
    {
      "id": "s032",
      "text": "There is no pneumothorax.",
      "start": 948,
      "end": 973,
      "source_start": 948,
      "source_end": 973,
      "line": 28,
      "page": 1
    },
    {
      "id": "s033",
      "text": "There is no pleural effusion.",
      "start": 974,
      "end": 1003,
      "source_start": 974,
      "source_end": 1003,
      "line": 29,
      "page": 1
    },
    {
      "id": "s034",
      "text": "However, a 12 mm ground-glass nodule is seen in the left mid-lung zone.",
      "start": 1004,
      "end": 1075,
      "source_start": 1004,
      "source_end": 1075,
      "line": 30,
      "page": 1
    },
    {
