      "source_start": 805,
      "source_end": 812,
      "line": 23,
      "page": 1
    },
    {
      "id": "s028",
      "text": "The trachea and main bronchi are patent.",
      "start": 813,
      "end": 853,
      "source_start": 813,
      "source_end": 853,
      "line": 24,
      "page": 1
    },
    {
      "id": "s029",
      "text": "Lungs and pleura",
      "start": 854,
      "end": 870,
      "source_start": 854,
      "source_end": 870,
      "line": 25,
      "page": 1
    },
    {
      "id": "s030",
      "text": "The lungs are well expanded.",
      "start": 871,
      "end": 899,
      "source_start": 871,
      "source_end": 899,
      "line": 26,
      "page": 1
    },
    {
      "id": "s031",
      "text": "There is no consolidation or pulmonary oedema.",
      "start": 900,
      "end": 946,
      "source_start": 900,
      "source_end": 946,
      "line": 27,
      "page": 1
    },
    {
      "id": "s032",
      "text": "There is no pneumothorax.",
      "start": 947,
      "end": 972,
      "source_start": 947,
      "source_end": 972,
      "line": 28,
      "page": 1
    },
    {
      "id": "s033",
      "text": "There is no pleural effusion.",
      "start": 973,
      "end": 1002,
      "source_start": 973,
      "source_end": 1002,
      "line": 29,
      "page": 1
    },
    {
