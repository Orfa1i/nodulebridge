      "end": 955,
      "source_start": 930,
      "source_end": 955,
      "line": 28,
      "page": 1
    },
    {
      "id": "s033",
      "text": "There is no pleural effusion.",
      "start": 956,
      "end": 985,
      "source_start": 956,
      "source_end": 985,
      "line": 29,
      "page": 1
    },
    {
