      "text": "Lungs and pleura",
      "start": 837,
      "end": 853,
      "source_start": 837,
      "source_end": 853,
      "line": 25,
      "page": 1
    },
    {
      "id": "s030",
      "text": "The lungs are well expanded.",
      "start": 854,
      "end": 882,
      "source_start": 854,
      "source_end": 882,
      "line": 26,
      "page": 1
    },
    {
      "id": "s031",
      "text": "There is no consolidation or pulmonary oedema.",
