      "source_start": 811,
      "source_end": 851,
      "line": 24,
      "page": 1
    },
    {
      "id": "s029",
      "text": "Lungs and pleura",
      "start": 852,
      "end": 868,
      "source_start": 852,
      "source_end": 868,
      "line": 25,
      "page": 1
    },
    {
      "id": "s030",
      "text": "The lungs are well expanded.",
      "start": 869,
      "end": 897,
      "source_start": 869,
      "source_end": 897,
      "line": 26,
      "page": 1
    },
    {
      "id": "s031",
      "text": "There is no consolidation or pulmonary oedema.",
