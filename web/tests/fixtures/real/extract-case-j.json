      "end": 944,
      "source_start": 898,
      "source_end": 944,
      "line": 27,
      "page": 1
    },
    {
      "id": "s032",
      "text": "There is no pneumothorax.",
      "start": 945,
      "end": 970,
      "source_start": 945,
      "source_end": 970,
      "line": 28,
      "page": 1
    },
    {
      "id": "s033",
      "text": "There is no pleural effusion.",
      "start": 971,
      "end": 1000,
      "source_start": 971,
      "source_end": 1000,
      "line": 29,
      "page": 1
    },
    {
